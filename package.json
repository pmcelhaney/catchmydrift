{
  "name": "catchmydrift",
  "version": "0.1.0",
  "description": "Checks watched files for drift against related Git-tracked changes",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "catchmydrift.schema.json",
    "catchmydrift-state.schema.json",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "changeset": "changeset",
    "release:version": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "release": "changeset publish",
    "build:action": "ncc build action/main.js -o dist --license licenses.txt"
  },
  "author": "Patrick McElhaney",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmcelhaney/catchmydrift.git"
  },
  "bugs": {
    "url": "https://github.com/pmcelhaney/catchmydrift/issues"
  },
  "homepage": "https://github.com/pmcelhaney/catchmydrift#readme",
  "bin": {
    "catchmydrift": "./index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "minimatch": "10.2.6"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@changesets/cli": "3.0.3",
    "@vercel/ncc": "0.45.0",
    "ajv": "8.20.0",
    "diff": "9.0.0"
  }
}
